{
  "name": "leaflet-node",
  "version": "3.0.0",
  "description": "Leaflet for Node.js - Run Leaflet maps in headless Node environments with full TypeScript support",
  "keywords": [
    "leaflet",
    "headless",
    "node",
    "maps",
    "typescript",
    "gis",
    "geojson",
    "tiles"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.mts",
        "default": "./dist/testing.mjs"
      },
      "require": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsx scripts/build-wrapper.ts",
    "dev": "tsdown --watch",
    "test": "npm run test:unit && npm run test:docs",
    "test:unit": "vitest run --exclude tests/docs.test.ts",
    "test:docs": "vitest run tests/docs.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --exclude tests/docs.test.ts",
    "lint": "biome check . && oxlint --type-aware --deny-warnings src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test",
    "release": "npm version patch && npm publish",
    "release:minor": "npm version minor && npm publish",
    "release:major": "npm version major && npm publish",
    "build:docs": "npm run build && tsx scripts/build-docs.ts",
    "preview:docs": "npm run build:docs && npx serve docs-dist",
    "format": "biome format --write .",
    "pretest:unit": "npm run build",
    "pretest:coverage": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jburnhams/leaflet-node.git"
  },
  "homepage": "https://jburnhams.github.io/leaflet-node/",
  "bugs": {
    "url": "https://github.com/jburnhams/leaflet-node/issues"
  },
  "author": "Jonathan Burnhams",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "peerDependencies": {
    "leaflet": "^1.9.0"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@napi-rs/canvas": "^1.1.0",
    "jsdom": "^31.0.0",
    "undici": "^8.12.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "leaflet": "^1.9.4",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "source-map": "^0.7.6"
  }
}
