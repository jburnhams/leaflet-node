{
  "name": "leaflet-node",
  "version": "2.0.27",
  "description": "Leaflet for Node.js - Run Leaflet maps in headless Node environments with full TypeScript support",
  "keywords": [
    "leaflet",
    "headless",
    "node",
    "maps",
    "typescript",
    "gis",
    "geojson",
    "tiles"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.mjs",
      "require": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsx scripts/build-wrapper.ts",
    "dev": "tsup --watch",
    "test": "npm run test:unit && npm run test:docs",
    "test:unit": "vitest run --exclude tests/docs.test.ts",
    "test:docs": "vitest run tests/docs.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --exclude tests/docs.test.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test",
    "release": "npm version patch && npm publish",
    "release:minor": "npm version minor && npm publish",
    "release:major": "npm version major && npm publish",
    "build:docs": "npm run build && tsx scripts/build-docs.ts",
    "preview:docs": "npm run build:docs && npx serve docs-dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jburnhams/leaflet-node.git"
  },
  "homepage": "https://jburnhams.github.io/leaflet-node/",
  "bugs": {
    "url": "https://github.com/jburnhams/leaflet-node/issues"
  },
  "author": "Jonathan Burnhams",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "peerDependencies": {
    "leaflet": "^1.9.0"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@napi-rs/canvas": "^1.1.0",
    "jsdom": "^31.0.0",
    "undici": "^8.12.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "leaflet": "^1.9.4",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "ts-jest": "^29.4.15",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "source-map": "^0.7.6"
  }
}
